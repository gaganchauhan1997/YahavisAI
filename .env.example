# ══════════════════════════════════════════════════════
# YAHAVIS — .env.example
# Copy to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════

# ── LLM Provider Keys (all free tiers) ───────────────
GROQ_API_KEY_1=gsk_xxxx
GROQ_API_KEY_2=gsk_xxxx
GROQ_API_KEY_3=gsk_xxxx
GEMINI_API_KEY_1=AIzaSy_xxxx
GEMINI_API_KEY_2=AIzaSy_xxxx
OPENROUTER_API_KEY=sk-or-xxxx

# ── Ollama (local — no key needed) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=mistral
OLLAMA_FALLBACK_MODEL=llama3

# ── Voice ─────────────────────────────────────────────
# Porcupine wake word (free tier at picovoice.io)
PORCUPINE_ACCESS_KEY=xxxx
# edge-tts voice (run: edge-tts --list-voices | grep en)
TTS_VOICE=en-US-GuyNeural
TTS_RATE=+10%
TTS_PITCH=+0Hz

# ── Hackknow / WooCommerce ────────────────────────────
WC_SITE_URL=https://shop.hackknow.com
WC_CONSUMER_KEY=ck_xxxx
WC_CONSUMER_SECRET=cs_xxxx
# Frontend site URL (used by hackknow_ops.check_frontend_build)
FRONTEND_URL=https://hackknow.com

# ── UI ────────────────────────────────────────────────
UI_PORT=7070
UI_HOST=127.0.0.1

# ── Operator ──────────────────────────────────────────
OPERATOR_NAME=Myth
OPERATOR_EMAIL=ceo.hackknow@gmail.com
YAHAVIS_VERSION=1.0.0
